# Board: QDtech / LCDWiki 2.8inch ESP32-32E Display (E32R28T)
# Module: ESP32-D0WD-V3, 4 MB flash, 520 KB SRAM, no PSRAM

CONFIG_IDF_TARGET="esp32"

# The module carries 4 MB of flash; the ESP-IDF default is 2 MB
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_ESPTOOLPY_FLASHSIZE="4MB"

# Full 240 MHz for smooth drawing into the framebuffer
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y

# Custom partition table (see partitions.csv): 3 MB application plus a 1 MB
# littlefs partition for the wallpaper JPEGs.
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_PARTITION_TABLE_FILENAME="partitions.csv"

# littlefs: the wallpaper file names reach 73 characters (littlefs limit is
# this value minus the NULL terminator), so raise it from the default 64.
# The image build passes the same value as --name-max.
CONFIG_LITTLEFS_OBJ_NAME_LEN=128

# XPT2046: the default pressure threshold of 400 is only ~30 counts below the
# lightest corner touch measured on this panel (bottom left, Z ~430), so the
# touch would drop out with slightly less pressure.  The untouched panel reads
# near 0, so 250 keeps a good margin on both sides.  Keep this in sync with
# BOARD_TOUCH_Z_THRESHOLD in main/board_e32r28t.h.
CONFIG_XPT2046_Z_THRESHOLD=250

# WiFi buffers live in static RAM and every kilobyte counts here: the 240x320
# framebuffer needs 150 KB in one piece, and the WiFi stack alone takes ~30 KB
# of the 192 KB DRAM segment.  A thermometer needs neither an access point of
# its own nor WPA3-Enterprise, so those features stay out of the build.
CONFIG_ESP_WIFI_SOFTAP_SUPPORT=n
CONFIG_ESP_WIFI_ENABLE_WPA3_SAE=n
CONFIG_ESP_WIFI_ENTERPRISE_SUPPORT=n

# Fewer static RX buffers (default 10, ~1.6 KB each) and no NTP-scale traffic;
# the dynamic buffers take over when more frames arrive.
CONFIG_ESP_WIFI_STATIC_RX_BUFFER_NUM=3
CONFIG_ESP_WIFI_DYNAMIC_RX_BUFFER_NUM=16
CONFIG_ESP_WIFI_RX_MGMT_BUF_NUM_DEF=2

# Keep the WiFi code in flash instead of IRAM.  Costs a little throughput,
# frees ~27 KB of IRAM which the heap can use for the network stack.
CONFIG_ESP_WIFI_IRAM_OPT=n
CONFIG_ESP_WIFI_RX_IRAM_OPT=n

# HTTPS for the sunrise-sunset request needs the default 16 KB TLS record
# buffer: the certificate chain of the server arrives as one record and does not
# fit into a smaller buffer (the handshake fails with a fatal error).
CONFIG_MBEDTLS_SSL_IN_CONTENT_LEN=16384

# api.sunrise-sunset.org presents its root "GTS Root R4" in the cross-signed
# variant (signed by GlobalSign Root CA, which is not in the bundle).  Without
# this option the ESP32 gives up with "No matching trusted root certificate
# found"; with it, mbedtls matches the cross-signed root against the bundle's
# self-signed GTS Root R4.  Costs ~700 bytes of heap.
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE_CROSS_SIGNED_VERIFY=y
